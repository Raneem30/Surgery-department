flowchart TD
    classDef entity fill:#e1f5fe,stroke:#01579b,stroke-width:2px,color:#000
    classDef attr fill:#fff9c4,stroke:#fbc02d,stroke-width:1px,color:#000

    eRoom[ROOM]:::entity

    aPk([room_id PK]):::attr
    aHospFk([hospital_id FK]):::attr
    aNum([room_number]):::attr
    aType([room_type]):::attr
    aAvail([is_available]):::attr

    eRoom --- aPk
    eRoom --- aHospFk
    eRoom --- aNum
    eRoom --- aType
    eRoom --- aAvail
